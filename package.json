{
  "name": "agendas-prado",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run migracao:dev",
    "test": "npm run migracao:test",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "build": "npm run migracao:build",
    "verify:production": "npm run verify:legacy",
    "check:migrations": "node scripts/check-migration-safety.mjs",
    "deploy": "node scripts/block-migration-deploy.mjs",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:worker": "vitest run",
    "bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "test:design": "node scripts/check-design-system.mjs",
    "test:deploy-flow": "node scripts/check-deploy-flow.mjs",
    "test:e2e:prepare": "node scripts/prepare-e2e.mjs",
    "test:e2e": "npm run build && npm run test:e2e:prepare && playwright test",
    "preview": "npm run migracao:dev",
    "test:bootstrap-admin": "node scripts/check-bootstrap-admin.mjs",
    "test:e2e:ci": "npm run test:e2e:prepare && playwright test",
    "deploy:cloudflare": "node scripts/block-migration-deploy.mjs",
    "migracao:build": "node scripts/build-native.mjs",
    "migracao:dev": "npm run migracao:build && wrangler dev --config wrangler.migracao.jsonc",
    "migracao:test": "node scripts/check-migracao-worker.mjs && node scripts/check-migracao-frontend.mjs && node --test tests/migration/*.test.js",
    "test:legacy": "npm run test:worker && npm run test:ui && npm run test:design && npm run test:deploy-flow && npm run test:bootstrap-admin",
    "build:legacy": "vite build",
    "verify:legacy": "npm run test:legacy && npm run typecheck && npm run build:legacy",
    "migracao:e2e": "playwright test --config playwright.migracao.config.js"
  },
  "dependencies": {
    "@llamaindex/liteparse-wasm": "^2.14.7",
    "hono": "^4.9.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "^1.62.2",
    "@cloudflare/vitest-plugin": "^1.3.3",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^27.0.0",
    "typescript": "^7.0.2",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "wrangler": "^4.144.0"
  }
}
