{
  // Ambiente LOCAL. Nunca usar este arquivo em deploy remoto.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agendas-pradosm-migracao-local",
  "compatibility_date": "2026-09-24",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agendas-pradosm-migracao-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "2026101801",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "REALTIME_HUB", "class_name": "RealtimeHub" }]
  },
  "migrations": [
    { "tag": "migracao-local-v1", "new_sqlite_classes": ["RealtimeHub"] }
  ],
  "vars": { "REALTIME_MODE": "off" }
}