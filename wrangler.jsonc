{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agendas-pradosm-preview",
  "compatibility_date": "2026-09-24",
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agendas-pradosm-preview",
      "database_id": "716cc88e-7da8-400e-b4be-edc4be0c9c03",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "2026100101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.05
    },
    "redact_query_string": true
  },
  "secrets": {
    "required": [
      "SESSION_SECRET"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_HUB",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "exports": {
    "RealtimeHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "REALTIME_MODE": "off"
  }
}
