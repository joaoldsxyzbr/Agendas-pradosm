{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agendas-pradosm-preview",
  "compatibility_date": "2026-09-24",
  "main": "./worker/index.js",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ],
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agendas-pradosm-preview-copia",
      "database_id": "6b2c7fec-5fbf-4db7-a0c4-d51860799c29",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "2026100101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.05
    },
    "redact_query_string": true
  },
  "secrets": {
    "required": [
      "SESSION_SECRET"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_HUB",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "exports": {
    "RealtimeHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "REALTIME_MODE": "off",
    "PREVIEW_DEMO_LOGIN": "on",
    "PREVIEW_DEPLOYMENT": "agendas-pradosm-preview"
  }
}
